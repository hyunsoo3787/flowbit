# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=3000
# The URL you open in the browser. In development that's the Vite dev server,
# which proxies /api to this server.
PUBLIC_URL=http://localhost:5173

DATABASE_URL=postgresql://flowbit:flowbit@localhost:5432/flowbit
VALKEY_URL=redis://localhost:6379

# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# AUTH_REQUIRE_EMAIL_VERIFICATION=false
# AUTH_DISABLE_SIGN_UP=false

# OAuth (optional). Callback URLs: ${PUBLIC_URL}/api/auth/callback/github|google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email (optional). Without SMTP_URL, emails are printed to the server log.
# SMTP_URL=smtp://user:pass@localhost:1025
# MAIL_FROM=Flowbit <no-reply@example.com>
