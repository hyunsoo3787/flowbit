// Flowbit database schema. This file is the single source of truth for
// migrations, including the tables owned by Better Auth (D-020).
// Model and field names are camelCase; tables and columns are snake_case.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Emit `.js` import specifiers so `tsc` with NodeNext resolution can build it.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity (managed by Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  locale        String    @default("en")
  /// Instance administrator (D-021): manages accounts, never content.
  isAdmin       Boolean   @default(false) @map("is_admin")
  /// Suspended accounts can't sign in; their sessions are ended on suspension.
  suspendedAt   DateTime? @map("suspended_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions                Session[]
  accounts                Account[]
  organizationMemberships OrganizationMember[]
  workspaceMemberships    WorkspaceMember[]
  personalOrganization    Organization?           @relation("PersonalOrganization")
  createdWorkspaces       Workspace[]             @relation("WorkspaceCreator")
  boardMemberships        BoardMember[]
  createdBoards           Board[]                 @relation("BoardCreator")
  createdCards            Card[]                  @relation("CardCreator")
  activities              Activity[]
  sentInvitations         Invitation[]            @relation("InvitationSender")
  cardAssignments         CardAssignee[]
  checklistItems          ChecklistItem[]         @relation("ChecklistItemAssignee")
  comments                Comment[]
  adminActions            AdminAction[]           @relation("AdminActionActor")
  adminActionsReceived    AdminAction[]           @relation("AdminActionTarget")
  watches                 Watch[]
  notifications           Notification[]          @relation("NotificationRecipient")
  notificationsCaused     Notification[]          @relation("NotificationActor")
  notificationPreference  NotificationPreference?

  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A way to sign in: a password ("credential") or an external identity
/// provider such as GitHub, Google or, later, an SSO connection.
model Account {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens: email verification, password reset, OAuth state.
model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Tenancy: Organization > Workspace (> Board, from phase 2). See D-008.
// ---------------------------------------------------------------------------

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  /// Set only for the personal organization created for each user.
  /// The unique constraint guarantees at most one per user.
  personalOwnerId String?  @unique @map("personal_owner_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  personalOwner User?                @relation("PersonalOrganization", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  members       OrganizationMember[]
  workspaces    Workspace[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Workspace {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdById    String?  @map("created_by_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      WorkspaceMember[]
  boards       Board[]
  invitations  Invitation[]

  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Boards, lists and cards (phase 2)
// ---------------------------------------------------------------------------

enum BoardVisibility {
  PRIVATE
  WORKSPACE
}

enum BoardRole {
  ADMIN
  MEMBER
  OBSERVER
}

model Board {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  name        String
  visibility  BoardVisibility @default(WORKSPACE)
  /// A #rrggbb color (lowercase); see BOARD_BACKGROUND_PRESETS in @flowbit/shared.
  background  String          @default("#93c5fd")
  createdById String?         @map("created_by_id") @db.Uuid
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("BoardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members       BoardMember[]
  lists         List[]
  cards         Card[]
  labels        Label[]
  activities    Activity[]
  invitations   Invitation[]
  watches       Watch[]
  notifications Notification[]

  @@index([workspaceId])
  @@map("boards")
}

model BoardMember {
  id        String    @id @default(uuid(7)) @db.Uuid
  boardId   String    @map("board_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      BoardRole
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

/// `position` is a fractional-index key (D-015). The migration gives it the
/// "C" collation so ORDER BY uses byte order, like the application does.
model List {
  id        String   @id @default(uuid(7)) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String
  position  String
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
  @@map("lists")
}

/// `boardId` duplicates `list.boardId` so permission checks and real-time
/// routing need no join; it is updated whenever a card or its list moves.
model Card {
  id             String    @id @default(uuid(7)) @db.Uuid
  boardId        String    @map("board_id") @db.Uuid
  listId         String    @map("list_id") @db.Uuid
  title          String
  description    String    @default("")
  position       String
  startAt        DateTime? @map("start_at")
  dueAt          DateTime? @map("due_at")
  dueCompletedAt DateTime? @map("due_completed_at")
  /// A cover color key from LABEL_COLORS; image covers arrive with attachments.
  coverColor     String?   @map("cover_color")
  /// The due date a "due soon" reminder was sent for; a new due date gets a new reminder.
  dueReminderAt  DateTime? @map("due_reminder_at")
  /// Denormalized counters for the badges on the board, kept in step by the services.
  commentCount   Int       @default(0) @map("comment_count")
  checklistTotal Int       @default(0) @map("checklist_total")
  checklistDone  Int       @default(0) @map("checklist_done")
  createdById    String?   @map("created_by_id") @db.Uuid
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  board         Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  list          List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("CardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activities    Activity[]
  assignees     CardAssignee[]
  labels        CardLabel[]
  checklists    Checklist[]
  comments      Comment[]
  watches       Watch[]
  notifications Notification[]

  @@index([listId, position])
  @@index([boardId])
  @@map("cards")
}

/// Append-only record of changes, written in the same transaction as the
/// change itself (see docs/ARCHITECTURE.md, "Write path").
model Activity {
  id        String   @id @default(uuid(7)) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  cardId    String?  @map("card_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card  Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  notifications Notification[]

  @@index([boardId, createdAt])
  @@index([cardId])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Phase 3: collaboration
// ---------------------------------------------------------------------------

/// An invitation to a workspace (boardId null) or to one board. With an email
/// it is for that person and used once; without, it is a shareable link that
/// works until it expires or is revoked.
model Invitation {
  id            String         @id @default(uuid(7)) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  boardId       String?        @map("board_id") @db.Uuid
  email         String?
  token         String         @unique
  workspaceRole WorkspaceRole? @map("workspace_role")
  boardRole     BoardRole?     @map("board_role")
  invitedById   String?        @map("invited_by_id") @db.Uuid
  expiresAt     DateTime       @map("expires_at")
  acceptedAt    DateTime?      @map("accepted_at")
  revokedAt     DateTime?      @map("revoked_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  board     Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([boardId])
  @@index([email])
  @@map("invitations")
}

model CardAssignee {
  cardId    String   @map("card_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
  @@map("card_assignees")
}

model Label {
  id        String   @id @default(uuid(7)) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String   @default("")
  /// A key from LABEL_COLORS in @flowbit/shared.
  color     String
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardLabel[]

  @@index([boardId])
  @@map("labels")
}

model CardLabel {
  cardId    String   @map("card_id") @db.Uuid
  labelId   String   @map("label_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}

model Checklist {
  id        String   @id @default(uuid(7)) @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  title     String
  position  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card  Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([cardId, position])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  checklistId String    @map("checklist_id") @db.Uuid
  text        String
  position    String
  completedAt DateTime? @map("completed_at")
  assigneeId  String?   @map("assignee_id") @db.Uuid
  dueAt       DateTime? @map("due_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("ChecklistItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([checklistId, position])
  @@map("checklist_items")
}

model Comment {
  id        String    @id @default(uuid(7)) @db.Uuid
  cardId    String    @map("card_id") @db.Uuid
  authorId  String?   @map("author_id") @db.Uuid
  /// Markdown. Mentions are stored as <@userId>.
  body      String
  editedAt  DateTime? @map("edited_at")
  createdAt DateTime  @default(now()) @map("created_at")

  card   Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// Instance administration (D-021)
// ---------------------------------------------------------------------------

/// Server settings changed at runtime by instance administrators.
model InstanceSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("instance_settings")
}

/// Append-only log of what instance administrators did.
model AdminAction {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Null for actions from the command line or the setup page.
  actorId      String?  @map("actor_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  type         String
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  actor      User? @relation("AdminActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AdminActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_actions")
}

// ---------------------------------------------------------------------------
// Phase 4: watching and notifications
// ---------------------------------------------------------------------------

/// Someone following a board or a card (exactly one of the two is set).
model Watch {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  boardId   String?  @map("board_id") @db.Uuid
  cardId    String?  @map("card_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board? @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card  Card?  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId])
  @@unique([userId, cardId])
  @@index([boardId])
  @@index([cardId])
  @@map("watches")
}

/// Something a user should know about. Shown in the app; also emailed,
/// depending on the user's preferences.
model Notification {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// One of NOTIFICATION_TYPES in @flowbit/shared.
  type       String
  actorId    String?   @map("actor_id") @db.Uuid
  boardId    String    @map("board_id") @db.Uuid
  cardId     String?   @map("card_id") @db.Uuid
  activityId String?   @map("activity_id") @db.Uuid
  payload    Json      @default("{}")
  readAt     DateTime? @map("read_at")
  emailedAt  DateTime? @map("emailed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor    User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card     Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId, id])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Which notifications a user also gets by email. In-app notifications are always on.
model NotificationPreference {
  userId           String   @id @map("user_id") @db.Uuid
  emailMentions    Boolean  @default(true) @map("email_mentions")
  emailAssignments Boolean  @default(true) @map("email_assignments")
  emailWatching    Boolean  @default(true) @map("email_watching")
  emailDueSoon     Boolean  @default(true) @map("email_due_soon")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
