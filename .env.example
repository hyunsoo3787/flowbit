# Configuration for docker-compose.yml. Copy to .env and adjust.

# The URL people use to open Flowbit. Must match exactly (scheme, host, port).
PUBLIC_URL=http://localhost:3000
# Port published on the host.
FLOWBIT_PORT=3000

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Database password used by the bundled PostgreSQL.
POSTGRES_PASSWORD=change-me

# Set to true to start with sign-up closed (existing users can still sign in,
# and invited people can still sign up). Administrators can change this later
# on the admin page.
# AUTH_DISABLE_SIGN_UP=false

# Instance administrators by email, comma-separated (optional). Only honored
# when email verification is on, for verified addresses. Usually you don't need
# it: open the setup link printed in the log when the server first starts.
# ADMIN_EMAILS=you@example.com

# Email (recommended). Without it, emails are only written to the log and
# email verification is not required.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Flowbit <no-reply@example.com>

# Sign in with GitHub / Google (optional).
# Callback URLs: ${PUBLIC_URL}/api/auth/callback/github and .../google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
