// Flowbit database schema. This file is the single source of truth for
// migrations, including the tables owned by Better Auth (D-020).
// Model and field names are camelCase; tables and columns are snake_case.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Emit `.js` import specifiers so `tsc` with NodeNext resolution can build it.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity (managed by Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  locale        String   @default("en")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions                Session[]
  accounts                Account[]
  organizationMemberships OrganizationMember[]
  workspaceMemberships    WorkspaceMember[]
  personalOrganization    Organization?        @relation("PersonalOrganization")
  createdWorkspaces       Workspace[]          @relation("WorkspaceCreator")
  boardMemberships        BoardMember[]
  createdBoards           Board[]              @relation("BoardCreator")
  createdCards            Card[]               @relation("CardCreator")
  activities              Activity[]

  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A way to sign in: a password ("credential") or an external identity
/// provider such as GitHub, Google or, later, an SSO connection.
model Account {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens: email verification, password reset, OAuth state.
model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Tenancy: Organization > Workspace (> Board, from phase 2). See D-008.
// ---------------------------------------------------------------------------

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  /// Set only for the personal organization created for each user.
  /// The unique constraint guarantees at most one per user.
  personalOwnerId String?  @unique @map("personal_owner_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  personalOwner User?                @relation("PersonalOrganization", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  members       OrganizationMember[]
  workspaces    Workspace[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Workspace {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdById    String?  @map("created_by_id") @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      WorkspaceMember[]
  boards       Board[]

  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Boards, lists and cards (phase 2)
// ---------------------------------------------------------------------------

enum BoardVisibility {
  PRIVATE
  WORKSPACE
}

enum BoardRole {
  ADMIN
  MEMBER
  OBSERVER
}

model Board {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  name        String
  visibility  BoardVisibility @default(WORKSPACE)
  /// A #rrggbb color (lowercase); see BOARD_BACKGROUND_PRESETS in @flowbit/shared.
  background  String          @default("#93c5fd")
  createdById String?         @map("created_by_id") @db.Uuid
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User?         @relation("BoardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members    BoardMember[]
  lists      List[]
  cards      Card[]
  activities Activity[]

  @@index([workspaceId])
  @@map("boards")
}

model BoardMember {
  id        String    @id @default(uuid(7)) @db.Uuid
  boardId   String    @map("board_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      BoardRole
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

/// `position` is a fractional-index key (D-015). The migration gives it the
/// "C" collation so ORDER BY uses byte order, like the application does.
model List {
  id        String   @id @default(uuid(7)) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String
  position  String
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
  @@map("lists")
}

/// `boardId` duplicates `list.boardId` so permission checks and real-time
/// routing need no join; it is updated whenever a card or its list moves.
model Card {
  id          String   @id @default(uuid(7)) @db.Uuid
  boardId     String   @map("board_id") @db.Uuid
  listId      String   @map("list_id") @db.Uuid
  title       String
  description String   @default("")
  position    String
  createdById String?  @map("created_by_id") @db.Uuid
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  board      Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  list       List       @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("CardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activities Activity[]

  @@index([listId, position])
  @@index([boardId])
  @@map("cards")
}

/// Append-only record of changes, written in the same transaction as the
/// change itself (see docs/ARCHITECTURE.md, "Write path").
model Activity {
  id        String   @id @default(uuid(7)) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  cardId    String?  @map("card_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card  Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
  @@index([cardId])
  @@map("activities")
}
